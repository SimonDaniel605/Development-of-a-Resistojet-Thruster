#include "main.h"
#include <math.h>
#include "control.h"
#include "sensors.h"
#include "usb.h"

// Tank pressure hysteresis thresholds (bar) to prevent state chatter
#define TANK_LOADED_PRESSURE    1.2f
#define TANK_UNLOADED_PRESSURE  1.0f
// Plenum settling criteria
#define SETTLING_PRESSURE_TOLERANCE    0.01f   // bar
#define SETTLING_TEMPERATURE_TOLERANCE 0.2f    // K
#define SETTLING_TIME                  2000    // ms
// Plenum priming criteria
#define PRIMING_PRESSURE_TOLERANCE     0.05f   // bar
#define PRIMING_TEMPERATURE_TOLERANCE  1.0f    // K
// Thruster firing criteria
#define FIRING_PRESSURE_TOLERANCE      0.05f   // bar
#define FIRING_TIME                    2000    // ms

// Thruster mode and state
ThrusterMode_t thrusterMode = MODE_EXPERIMENTAL;
ThrusterState_t thrusterState = STATE_LOADED;

// Thruster control targets
float plenumTempSetpoint = 0.0f;
float chamberTempSetpoint = 0.0f;
float plenumTargetTemp = 0.0f;
float plenumTargetPressure = 0.0f;

// Previous settling variables
uint32_t settle_last = 0;
float settle_last_pressure = 0.0f;
float settle_last_temp = 0.0f;

// Priming variables
float primingFillPressure = 0.0f;

// Previous settling variables
uint32_t firing_last = 0;
float firing_last_pressure = 0.0f;
float firing_last_temp = 0.0f;

void PIDFunc(void){}

void settlingFunc(void){
    if (!settlingFlag)
        return;
    // Empty plenum
    fillValveFlag = 0;
    plenumValveFlag = 0;
    chamberValveFlag = 1;
    // Turn off heaters
    plenumTempSetpoint = 0.0f;
    chamberTempSetpoint = 0.0f;

    uint32_t settle_now = HAL_GetTick();
    // Check for plenum stability
    if ((settle_now - settle_last) >= SETTLING_TIME){
        float settle_now_pressure = plenumPressure;
        float settle_now_temp = plenumBodyTemperature;
        if ((fabsf(settle_now_pressure - settle_last_pressure) <
             SETTLING_PRESSURE_TOLERANCE) &&
            (fabsf(settle_now_temp - settle_last_temp) <
             SETTLING_TEMPERATURE_TOLERANCE)){
            // Plenum has settled
            settlingFlag = 0;
            chamberValveFlag = 0;
        }
        settle_last = settle_now;
        settle_last_pressure = settle_now_pressure;
        settle_last_temp = settle_now_temp;
    }
}
/*
void primingFunc(void){
	if (primingFlag){}
	if () primingFlag = 0;
}*/
void firingFunc(void){
	if (!firingFlag)
		return;
	streamFlag = 1; // Stream experimental data
	fillValveFlag = 0;
	plenumValveFlag = 0;
	chamberValveFlag = 1; // Fire thruster

    uint32_t firing_now = HAL_GetTick();
    // Check for plenum stability
    if ((firing_now - firing_last) >= FIRING_TIME){
        float firing_now_pressure = plenumPressure;
        if (fabsf(firing_now_pressure - firing_last_pressure) <
             FIRING_PRESSURE_TOLERANCE){
            // Plenum has settled
            firingFlag = 0;
            streamFlag = 0;
            chamberValveFlag = 0;
        }
        firing_last = firing_now;
        firing_last_pressure = firing_now_pressure;
    }
}

const char *thrusterModeToString(ThrusterMode_t mode)
{
    switch (mode)
    {
    case MODE_EXPERIMENTAL:
        return "EXPERIMENTAL";

    case MODE_MANUAL:
        return "MANUAL";

    case MODE_RESTRICTED_MANUAL:
        return "RESTRICTED_MANUAL";

    default:
        return "UNKNOWN";
    }
}

const char *thrusterStateToString(ThrusterState_t state)
{
    switch (state)
    {
    case STATE_LOADED:
        return "LOADED";

    case STATE_UNLOADED:
        return "UNLOADED";

    case STATE_SETTLING:
        return "SETTLING";
    case STATE_SETTLED:
        return "SETTLED";

    case STATE_PRIMING:
        return "PRIMING";

    case STATE_PRIMED:
        return "PRIMED";

    case STATE_FIRING:
        return "FIRING";

    case STATE_ABORT:
        return "ABORT";

    default:
        return "UNKNOWN";
    }
}

/* The thruster mode handler must be executed first in the system while
 loop because the state handler clears the manual request flag */
void thrusterModeHandler(void){
	switch(thrusterMode)
	{
	case MODE_EXPERIMENTAL:
		if (manualRequest && (tankPressure > TANK_LOADED_PRESSURE))
			thrusterMode = MODE_RESTRICTED_MANUAL;
		else if (manualRequest && (tankPressure < TANK_UNLOADED_PRESSURE))
			thrusterMode = MODE_MANUAL;
		break;
	case MODE_MANUAL:
		if (tankPressure > TANK_LOADED_PRESSURE)
			thrusterMode = MODE_RESTRICTED_MANUAL;
		if (experimentalRequest && fillValveFlag == 0)
			thrusterMode = MODE_EXPERIMENTAL;
		break;
	case MODE_RESTRICTED_MANUAL:
		if (tankPressure < TANK_UNLOADED_PRESSURE)
			thrusterMode = MODE_MANUAL;
	    if (experimentalRequest &&
	    		plenumValveFlag == 0 &&
				chamberValveFlag == 0)
	    	thrusterMode = MODE_EXPERIMENTAL;
		break;
	}
}

void thrusterStateHandler(void){
    if (abortThrusterRequest)
    {
        resetAllRequests();
        thrusterState = STATE_ABORT;
    }

	switch(thrusterState)
	{
	case STATE_LOADED:
		if (tankPressure < TANK_UNLOADED_PRESSURE){
			thrusterState = STATE_UNLOADED;
			break;
		}
		if (settleThrusterRequest &&
				thrusterMode == MODE_EXPERIMENTAL){
			settlingFlag = 1;
			settle_last = HAL_GetTick();
			settle_last_pressure = plenumPressure;
			settle_last_temp = plenumBodyTemperature;
			thrusterState = STATE_SETTLING;
		}
		else if (streamOnRequest)  streamFlag = 1;
		else if (streamOffRequest) streamFlag = 0;
		else if (plenumValveOpenRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			plenumValveFlag = 1;
		else if (plenumValveCloseRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			plenumValveFlag = 0;
		else if (chamberValveOpenRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			chamberValveFlag = 1;
		else if (chamberValveCloseRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			chamberValveFlag = 0;
		else if (plenumHeaterRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL){}
		else if (chamberHeaterRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL){}
		else if (commandRequest)
			USB_Transmit("Command invalid at state %s and mode %s\r\n",
					thrusterStateToString(thrusterState),
					thrusterModeToString(thrusterMode));
		break;
	case STATE_UNLOADED:
		if (tankPressure > TANK_LOADED_PRESSURE){
			thrusterState = STATE_LOADED;
			break;
		}
		if (streamOnRequest)  streamFlag = 1;
		else if (streamOffRequest) streamFlag = 0;
		else if (fillValveOpenRequest &&
				thrusterMode == MODE_MANUAL)
			fillValveFlag = 1;
		else if (fillValveCloseRequest &&
				thrusterMode == MODE_MANUAL)
			fillValveFlag = 0;
		else if (plenumValveOpenRequest &&
				thrusterMode == MODE_MANUAL)
			plenumValveFlag = 1;
		else if (plenumValveCloseRequest &&
				thrusterMode == MODE_MANUAL)
			plenumValveFlag = 0;
		else if (chamberValveOpenRequest &&
				thrusterMode == MODE_MANUAL)
			chamberValveFlag = 1;
		else if (chamberValveCloseRequest &&
				thrusterMode == MODE_MANUAL)
			chamberValveFlag = 0;
		else if (plenumHeaterRequest &&
				thrusterMode == MODE_MANUAL){}
		else if (chamberHeaterRequest &&
				thrusterMode == MODE_MANUAL){}
		else if (commandRequest)
			USB_Transmit("Command invalid at state %s and mode %s\r\n",
					thrusterStateToString(thrusterState),
					thrusterModeToString(thrusterMode));
		break;
	case STATE_SETTLING:
		if (settlingFlag == 0) thrusterState = STATE_SETTLED;
		else if (streamOnRequest)  streamFlag = 1;
		else if (streamOffRequest) streamFlag = 0;
		else if (commandRequest)
			USB_Transmit("Command invalid at state %s and mode %s\r\n",
					thrusterStateToString(thrusterState),
					thrusterModeToString(thrusterMode));
		break;
	case STATE_SETTLED:
		if (primeThrusterRequest&&
			    thrusterMode == MODE_EXPERIMENTAL){
			primingFlag = 1;
			thrusterState = STATE_PRIMING;
		}
		else if (streamOnRequest)  streamFlag = 1;
		else if (streamOffRequest) streamFlag = 0;
		else if (plenumValveOpenRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			plenumValveFlag = 1;
		else if (plenumValveCloseRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			plenumValveFlag = 0;
		else if (chamberValveOpenRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			chamberValveFlag = 1;
		else if (chamberValveCloseRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			chamberValveFlag = 0;
		else if (plenumHeaterRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL){}
		else if (chamberHeaterRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL){}
		else if (commandRequest)
			USB_Transmit("Command invalid at state %s and mode %s\r\n",
					thrusterStateToString(thrusterState),
					thrusterModeToString(thrusterMode));
		break;
	case STATE_PRIMING:
		if (primingFlag == 0) thrusterState = STATE_PRIMED;
		else if (streamOnRequest)  streamFlag = 1;
		else if (streamOffRequest) streamFlag = 0;
		else if (commandRequest)
			USB_Transmit("Command invalid at state %s and mode %s\r\n",
					thrusterStateToString(thrusterState),
					thrusterModeToString(thrusterMode));
		break;
	case STATE_PRIMED:
		if (startThrusterRequest &&
				thrusterMode == MODE_EXPERIMENTAL){
			firingFlag = 1;
			firing_last = HAL_GetTick();
			firing_last_pressure = plenumPressure;
			thrusterState = STATE_FIRING;
		}
		else if (streamOnRequest)  streamFlag = 1;
		else if (streamOffRequest) streamFlag = 0;
		else if (plenumValveOpenRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			plenumValveFlag = 1;
		else if (plenumValveCloseRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			plenumValveFlag = 0;
		else if (chamberValveOpenRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			chamberValveFlag = 1;
		else if (chamberValveCloseRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			chamberValveFlag = 0;
		else if (plenumHeaterRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL){}
		else if (chamberHeaterRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL){}
		else if (commandRequest)
			USB_Transmit("Command invalid at state %s and mode %s\r\n",
					thrusterStateToString(thrusterState),
					thrusterModeToString(thrusterMode));
		break;
	case STATE_FIRING:
		if (firingFlag == 0) thrusterState = STATE_LOADED;
		else if (commandRequest)
			USB_Transmit("Command invalid at state %s and mode %s\r\n",
					thrusterStateToString(thrusterState),
					thrusterModeToString(thrusterMode));
		break;
	case STATE_ABORT:
		// Reset all valve flags
		fillValveFlag = 0;
		plenumValveFlag = 0;
		chamberValveFlag = 0;
		// Manually close all valves
		HAL_GPIO_WritePin(FILL_VALVE_Port, FILL_VALVE_Pin, GPIO_PIN_RESET);
		HAL_GPIO_WritePin(PLENUM_VALVE_Port, PLENUM_VALVE_Pin, GPIO_PIN_RESET);
		HAL_GPIO_WritePin(CHAMBER_VALVE_Port, CHAMBER_VALVE_Pin, GPIO_PIN_RESET);
		// Set all temperature setpoints to 0 K
		plenumTempSetpoint = 0.0f;
		chamberTempSetpoint = 0.0f;
		// Set heater PWM duty cycles to 0
		__HAL_TIM_SET_COMPARE(&htim4, HEATER1_CHANNEL, 0);
		__HAL_TIM_SET_COMPARE(&htim4, HEATER2_CHANNEL, 0);
		// Reset all state flags
		settlingFlag = 0;
		primingFlag = 0;
		firingFlag = 0;

		thrusterMode = MODE_EXPERIMENTAL;
		thrusterState = STATE_LOADED;
		break;
	default:
		thrusterState = STATE_LOADED;
		break;
	}
	resetAllRequests();
}
