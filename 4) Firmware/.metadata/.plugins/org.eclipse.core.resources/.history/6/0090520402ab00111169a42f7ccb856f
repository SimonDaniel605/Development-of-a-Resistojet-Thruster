#include "main.h"
#include "control.h"
#include "sensors.h"
#include "usb.h"

// Tank pressure hysteresis thresholds (bar) to prevent state chatter
#define TANK_LOADED_PRESSURE    1.2f
#define TANK_UNLOADED_PRESSURE  1.0f

// Thruster mode and state
ThrusterMode_t thrusterMode = MODE_EXPERIMENTAL;
ThrusterState_t thrusterState = STATE_LOADED;

// Thruster control targets
float plenumTempSetpoint = 0.0f;
float chamberTempSetpoint = 0.0f;
float plenumTargetTemp = 0.0f;
float plenumTargetPressure = 0.0f;

void PIDFunc(void){}

const char *thrusterModeToString(ThrusterMode_t mode)
{
    switch (mode)
    {
    case MODE_EXPERIMENTAL:
        return "EXPERIMENTAL";

    case MODE_MANUAL:
        return "MANUAL";

    case MODE_RESTRICTED_MANUAL:
        return "RESTRICTED_MANUAL";

    default:
        return "UNKNOWN";
    }
}

const char *thrusterStateToString(ThrusterState_t state)
{
    switch (state)
    {
    case STATE_LOADED:
        return "LOADED";

    case STATE_UNLOADED:
        return "UNLOADED";

    case STATE_SETTLING:
        return "SETTLING";
    case STATE_SETTLED:
        return "SETTLED";

    case STATE_PRIMING:
        return "PRIMING";

    case STATE_PRIMED:
        return "PRIMED";

    case STATE_FIRING:
        return "FIRING";

    case STATE_ABORT:
        return "ABORT";

    default:
        return "UNKNOWN";
    }
}

void thrusterModeHandler(void){
	switch(thrusterMode)
	{
	case MODE_EXPERIMENTAL:
		break;
	case MODE_MANUAL:
		if (tankPressure > TANK_LOADED_PRESSURE)
			thrusterMode = MODE_RESTRICTED_MANUAL;
		break;
	case MODE_RESTRICTED_MANUAL:
		if (tankPressure < TANK_UNLOADED_PRESSURE)
			thrusterMode = MODE_MANUAL;
		break;
	}
}

void thrusterStateHandler(void){
	switch(thrusterState)
	{
	case STATE_LOADED:
		if (tankPressure < TANK_UNLOADED_PRESSURE)
			thrusterState = STATE_UNLOADED;
		if (manualRequest)
			thrusterMode == MODE_RESTRICTED_MANUAL;
		else if (experimentalRequest &&
				fillValveFlag == 0)
			thrusterMode = MODE_EXPERIMENTAL;
		else if (abortThrusterRequest)
			abortingThrusterFlag = 1;
		else if (settleThrusterRequest) thrusterState = STATE_SETTLING;
		else if (primeThrusterRequest)  primingThrusterFlag = 1;
		else if (startThrusterRequest)   firingThrusterFlag = 1;
		else if (streamOnRequest)  streamFlag = 1;
		else if (streamOffRequest) streamFlag = 0;
		else if (plenumValveOpenRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			plenumValveFlag = 1;
		else if (plenumValveCloseRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			plenumValveFlag = 0;
		else if (chamberValveOpenRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			chamberValveFlag = 1;
		else if (chamberValveCloseRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			chamberValveFlag = 0;
		else if (plenumHeaterRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL){}
		else if (chamberHeaterRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL){}
		else USB_Transmit("Command invalid at state %s and mode %s\r\n",
				thrusterStateToString(thrusterState),
				thrusterModeToString(thrusterMode));
		resetAllRequests();
		break;
	case STATE_UNLOADED:
		if (tankPressure > TANK_LOADED_PRESSURE)
			thrusterState = STATE_LOADED;
		if (manualRequest)
			thrusterMode == MODE_MANUAL;
		else if (experimentalRequest &&
				fillValveFlag == 0)
			thrusterMode = MODE_EXPERIMENTAL;
		else if (abortThrusterRequest)
			abortingThrusterFlag = 1;
		else if (streamOnRequest)  streamFlag = 1;
		else if (streamOffRequest) streamFlag = 0;
		else if (fillValveOpenRequest &&
				thrusterMode == MODE_MANUAL)
			fillValveFlag = 1;
		else if (fillValveCloseRequest &&
				thrusterMode == MODE_MANUAL)
			fillValveFlag = 0;
		else if (plenumValveOpenRequest &&
				thrusterMode == MODE_MANUAL)
			plenumValveFlag = 1;
		else if (plenumValveCloseRequest &&
				thrusterMode == MODE_MANUAL)
			plenumValveFlag = 0;
		else if (chamberValveOpenRequest &&
				thrusterMode == MODE_MANUAL)
			chamberValveFlag = 1;
		else if (chamberValveCloseRequest &&
				thrusterMode == MODE_MANUAL)
			chamberValveFlag = 0;
		else if (plenumHeaterRequest &&
				thrusterMode == MODE_MANUAL){}
		else if (chamberHeaterRequest &&
				thrusterMode == MODE_MANUAL){}
		else USB_Transmit("Command invalid at state %s and mode %s\r\n",
				thrusterStateToString(thrusterState),
				thrusterModeToString(thrusterMode));
		resetAllRequests();
		break;
	case STATE_SETTLING:
		break;
	case STATE_SETTLED:
		if (primeThrusterRequest) thrusterState = STATE_PRIMING;

		else if (streamOnRequest)  streamFlag = 1;
		else if (streamOffRequest) streamFlag = 0;
		else if (plenumValveOpenRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			plenumValveFlag = 1;
		else if (plenumValveCloseRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			plenumValveFlag = 0;
		else if (chamberValveOpenRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			chamberValveFlag = 1;
		else if (chamberValveCloseRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			chamberValveFlag = 0;
		else if (plenumHeaterRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL){}
		else if (chamberHeaterRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL){}
		else USB_Transmit("Command invalid at state %s and mode %s\r\n",
				thrusterStateToString(thrusterState),
				thrusterModeToString(thrusterMode));
		resetAllRequests();
		break;
	case STATE_PRIMING:
		break;
	case STATE_PRIMED:
		if (startThrusterRequest) thrusterState = STATE_FIRING;
		else if (streamOnRequest)  streamFlag = 1;
		else if (streamOffRequest) streamFlag = 0;
		else if (plenumValveOpenRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			plenumValveFlag = 1;
		else if (plenumValveCloseRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			plenumValveFlag = 0;
		else if (chamberValveOpenRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			chamberValveFlag = 1;
		else if (chamberValveCloseRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL)
			chamberValveFlag = 0;
		else if (plenumHeaterRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL){}
		else if (chamberHeaterRequest &&
				thrusterMode == MODE_RESTRICTED_MANUAL){}
		else USB_Transmit("Command invalid at state %s and mode %s\r\n",
				thrusterStateToString(thrusterState),
				thrusterModeToString(thrusterMode));
		resetAllRequests();
		break;
	case STATE_FIRING:
		break;
	case STATE_ABORT:
		break;
	default:
		thrusterState = STATE_ABORT;
		break;
	}
}
