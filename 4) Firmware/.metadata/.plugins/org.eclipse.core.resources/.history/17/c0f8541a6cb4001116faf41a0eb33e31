static int32_t ADS131M04_Convert24Bit(uint8_t *data){
    // Combine three bytes into a 24-bit value
    int32_t value = ((int32_t)data[0] << 16) |
                    ((int32_t)data[1] << 8)  |
                    ((int32_t)data[2]);
    // Sign extend from 24-bit signed to 32-bit signed
    if (value & 0x00800000)
    	value |= 0xFF000000;
    return value;
}
