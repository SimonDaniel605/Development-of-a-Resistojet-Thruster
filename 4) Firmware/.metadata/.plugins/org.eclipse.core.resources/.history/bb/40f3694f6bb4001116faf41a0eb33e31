static float thermocoupleVoltageToTemperature(float voltage){
	/*
	 https://its90.nist.gov/downloadFiles/type_k.tab.txt
	 Temperature range 0 to 500 deg C
	 Voltage range 0 to 20.644 mV
	 Error range 0.04 to -0.05 deg C
	 */
	float temp;
	temp = 0 + (2.508355e1)*voltage + (7.860106e-2)*voltage^2 + (-2.503131e-1)*voltage^3 +
			(8.315270e-2)*voltage^4 + (-1.228034e-2)*voltage^5 + (9.804036e-4)*voltage^6 +
			(-4.413030e-5)*voltage^7 + (1.057734e-6)*voltage^8 + (-1.052755e-8)*voltage^9;
	return temp;
}


/*
 The coefficients for Temperature range 0 deg C to 500 deg C

 Voltage range 0 mV to 20.644 mV

 Error range .04 deg C to -.05 deg C are:


 C0 = 0
 C1 = 2.508355 * 10^1
 C2 = 7.860106 * 10^-2
 C3 = -2.503131 * 10^-1
 C4 = 8.315270 * 10^-2
 C5 = -1.228034 * 10^-2
 C6 = 9.804036 * 10^-4
 C7 = -4.413030 * 10^-5

 C8 = 1.057734 * 10^-6

 C9 = -1.052755 * 10^-8
*/
